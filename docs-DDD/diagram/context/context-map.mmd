%% Module Map — Student Management
%% ONE bounded context, two internal modules.
%% ---
%% Rationale: the system is a single Spring Boot module over a single PostgreSQL
%% schema, and books.student_id is a real foreign key to students.id. Modelling
%% Academic and Library as separate bounded contexts would require an
%% anti-corruption layer that the implementation will never build, so they are
%% modules (Java packages) inside one context instead. Isolation is enforced by
%% package boundaries and by the identity-only reference rule below, not by a
%% network hop.

flowchart LR
  subgraph SM[Bounded Context: Student Management]
    direction LR

    subgraph Academic[Module: academic]
      direction TB
      A_Student["Student «AggregateRoot»"]
      A_Course["Course «AggregateRoot»"]
      A_Enrollment["Enrollment «AggregateRoot»"]
      A_Enrollment -->|"references by id: studentId"| A_Student
      A_Enrollment -->|"references by id: courseId"| A_Course
    end

    subgraph Library[Module: library]
      direction TB
      L_Book["Book «AggregateRoot»"]
      L_Policy["OwnershipPolicy «DomainService»"]
      L_Policy -->|"guards"| L_Book
    end

    subgraph App[Layer: application]
      direction TB
      SVC["StudentApplicationService"]
    end
  end

  %% Cross-module dependency — one direction only
  L_Book -.->|"references by id: ownerId : StudentId (nullable)"| A_Student

  %% Deletion cleanup: exactly ONE mechanism
  SVC ==>|"1. release owned books (ownerId := null)"| L_Book
  SVC ==>|"2. delete enrollments"| A_Enrollment
  SVC ==>|"3. delete student"| A_Student

  %% Invariants owned per module
  A_Enrollment -.-|"invariant: no duplicate (studentId, courseId)"| A_Course
  L_Policy -.-|"invariant: a book has at most one owner"| L_Book

  classDef academic fill:#eef,stroke:#333,stroke-width:1px;
  classDef library fill:#efe,stroke:#333,stroke-width:1px;
  classDef app fill:#ffe,stroke:#333,stroke-width:1px;
  classDef ctx fill:#fafafa,stroke:#333,stroke-dasharray:4 3;

  class A_Student,A_Course,A_Enrollment academic
  class L_Book,L_Policy library
  class SVC app
  class SM ctx

%% Rules this map asserts
%% -----------------------------------------------------------------------------
%% R1. library may depend on academic identity (StudentId) only. It never imports
%%     the Student aggregate, and never navigates Student -> Book.
%% R2. academic has no compile-time dependency on library. Student deletion is
%%     orchestrated from the application layer, which may see both modules.
%% R3. Aggregates reference each other by identity, never by object reference.
%%     Book holds ownerId : StudentId, not a Student.
%% R4. Cross-aggregate consistency (releasing books when a student is deleted)
%%     is achieved inside one @Transactional application-service method.
%% ---
%% Deferred, NOT current design
%% -----------------------------------------------------------------------------
%% Domain events (StudentDeleted, BookAssigned, StudentEnrolled) and eventual
%% consistency are deliberately out of scope. If the modules are ever split into
%% separate deployables, R4 becomes an event-driven saga and an anti-corruption
%% layer is introduced at that point — not before.
