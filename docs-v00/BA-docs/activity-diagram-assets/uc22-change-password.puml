@startuml
skinparam backgroundColor transparent
skinparam activity {
  BackgroundColor #F6F8FA
  BorderColor #57606A
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #3730A3
}
skinparam swimlane {
  BorderColor #57606A
  TitleBackgroundColor #EEF2FF
}

|Actor (any role)|
start
:Enter current password, new password,\nand retyped new password;

|System|
if (Retyped new password matches new password?) then (no)
  :Reject — validation error;
  |Actor (any role)|
  stop
endif
if (Current password matches account's password?) then (no)
  :Reject — authentication error;
  |Actor (any role)|
  stop
endif
if (New password meets policy and differs\nfrom current password?) then (no)
  :Reject — validation error;
  |Actor (any role)|
  stop
endif
:Replace account's password with the new one;
:Clear "must change password" state, if set;
:Confirm password changed;

|Actor (any role)|
:Receive confirmation;
stop
@enduml
