@startuml
skinparam backgroundColor transparent
skinparam activity {
  BackgroundColor #F6F8FA
  BorderColor #57606A
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #3730A3
}
skinparam swimlane {
  BorderColor #57606A
  TitleBackgroundColor #EEF2FF
}

|Registrar|
start
:Select a student to remove;

|System|
:Clear ownership link on every book\nthe student owns (books remain in catalog);
:Remove every enrollment the student holds\n(courses remain unaffected);
:Remove the student's user account;
:Delete the student record;
:Confirm removal;

|Registrar|
:Receive confirmation;
stop
@enduml
