@startuml
skinparam backgroundColor transparent
skinparam activity {
  BackgroundColor #F6F8FA
  BorderColor #57606A
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #3730A3
}
skinparam swimlane {
  BorderColor #57606A
  TitleBackgroundColor #EEF2FF
}

|Course Administrator|
start
:Select a course to remove;

|System|
:Remove every enrollment tied to the course;
:Delete the course record;
:Confirm removal;

|Course Administrator|
:Receive confirmation\n(enrolled students remain, unaffected);
stop
@enduml
