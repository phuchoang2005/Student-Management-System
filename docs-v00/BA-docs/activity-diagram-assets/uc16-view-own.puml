@startuml
skinparam backgroundColor transparent
skinparam activity {
  BackgroundColor #F6F8FA
  BorderColor #57606A
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #3730A3
}
skinparam swimlane {
  BorderColor #57606A
  TitleBackgroundColor #EEF2FF
}

|Student|
start
:Select "my details", "my books",\nor "my courses";

|System|
:Identify the student from the\nauthenticated session\n(no caller-supplied code);
if (Which view?) then (my details)
  if (Student record still exists?) then (no)
    :Report that the record\nno longer exists;
    |Student|
    stop
  else (yes)
  endif
  :Return the student's own record,\nincluding their student code;
elseif (my books) then
  :Look up books held by the student;
  if (Holds any books?) then (no)
    :Return an empty page;
  else (yes)
    :Return one page of book summaries;
  endif
else (my courses)
  :Look up active enrollments\nfor the student;
  if (Has any active enrollments?) then (no)
    :Return an empty page;
  else (yes)
    :Return one page of course summaries;
  endif
endif

|Student|
:View own record / books / courses;
if (Select a book?) then (yes)
  :Continue at UC-18\n(View Book Detail);
elseif (Select a course?) then (yes)
  :Continue at UC-19\n(View Course Detail);
else (no)
endif
stop

note right
  Each view pages on its own, so
  browsing books never disturbs
  the courses view.

  A Student reaches enrolled
  courses only here -- UC-20's
  lookups are not available to them.
end note
@enduml
