@startuml
left to right direction
skinparam backgroundColor transparent
skinparam nodesep 40
skinparam ranksep 120
skinparam usecase {
  BackgroundColor #F6F8FA
  BorderColor #57606A
}
skinparam actor {
  BackgroundColor #EEF2FF
  BorderColor #3730A3
}

actor Student

rectangle "Student Self-Service" {
  usecase "UC-16\nView Own Record,\nBooks & Courses" as UC16
}

usecase "UC-18\nView Book Detail\n(see Book Management)" as UC18ext #line.dashed
usecase "UC-19\nView Course Detail\n(see Course Management)" as UC19ext #line.dashed

Student --> UC16

UC16 ..> UC18ext : <<extend>>
UC16 ..> UC19ext : <<extend>>

note bottom of UC16
  The one lookup with no
  caller-supplied key: the system
  identifies the Student from the
  session. UC-20's enrollment
  lookups are not reachable here.
end note
@enduml
