@startuml
skinparam backgroundColor transparent
skinparam activity {
  BackgroundColor #F6F8FA
  BorderColor #57606A
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #3730A3
}
skinparam swimlane {
  BorderColor #57606A
  TitleBackgroundColor #EEF2FF
}

|Registrar|
start
:Supply the student code and the course code\nof the enrollment to end;

|System|
if (An active enrollment exists for that pair?) then (no)
  :Report not found\n(the same answer whether the student\nis unknown or simply not enrolled);
  |Registrar|
  stop
else (yes)
endif
:Remove the enrollment link only;
:Confirm removal;

|Registrar|
:Receive confirmation\n(student and course both unaffected);
stop
@enduml
