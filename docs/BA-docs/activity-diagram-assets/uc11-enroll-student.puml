@startuml
skinparam backgroundColor transparent
skinparam activity {
  BackgroundColor #F6F8FA
  BorderColor #57606A
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #3730A3
}
skinparam swimlane {
  BorderColor #57606A
  TitleBackgroundColor #EEF2FF
}

|Registrar|
start
:Supply a student code and a course code;

|System|
if (Student code resolves to a student?) then (no)
  :Reject -- no such student;
  |Registrar|
  stop
endif
if (Course code resolves to a course?) then (no)
  :Reject -- no such course;
  |Registrar|
  stop
endif
if (Existing enrollment for this pair?) then (yes)
  :Reject -- duplicate enrollment;
  |Registrar|
  stop
endif
:Create the enrollment;
:Confirm enrollment,\nechoing the codes supplied;

|Registrar|
:Receive confirmation;
stop

note right
  Both sides are business codes.
  The Registrar never handles a
  database identifier -- resolving
  the student code is also the
  "student exists" check.
end note
@enduml
