@startuml
skinparam backgroundColor transparent
skinparam activity {
  BackgroundColor #F6F8FA
  BorderColor #57606A
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #3730A3
}
skinparam swimlane {
  BorderColor #57606A
  TitleBackgroundColor #EEF2FF
}

|Registrar|
start
:Select a student\n(e.g. from that student's detail view);

|System|
if (Account still using initial password?) then (no)
  :Indicate initial password\nno longer available to anyone;
  |Registrar|
  stop
endif
:Return the initial password;

|Registrar|
:View initial password;
stop
@enduml
