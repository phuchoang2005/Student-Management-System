@startuml
skinparam backgroundColor transparent
skinparam activity {
  BackgroundColor #F6F8FA
  BorderColor #57606A
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #3730A3
}
skinparam swimlane {
  BorderColor #57606A
  TitleBackgroundColor #EEF2FF
}

|Librarian|
start
:Enter ISBN, or title/author search term,\noptionally with an owner filter;

|System|
:Look up matching book record(s);
if (Any match found?) then (no)
  :Return empty result;
else (yes)
  :Return matching book summaries\n(ISBN, title, author, owner if any);
endif

|Librarian|
:View results;
if (Select one result?) then (yes)
  :Continue at UC-18\n(View Book Detail);
else (no)
endif
stop
@enduml
