@startuml
left to right direction
skinparam packageStyle rectangle
skinparam backgroundColor transparent
skinparam nodesep 50
skinparam ranksep 110
skinparam usecase {
  BackgroundColor #F6F8FA
  BorderColor #57606A
}
skinparam actor {
  BackgroundColor #EEF2FF
  BorderColor #3730A3
}

' Actor and use-case declaration order below is chosen (via brute-force
' crossing-count search) to minimize arrow crossings for this many-to-many
' fan-out; it does not need to match the actor order in other diagrams.
actor Registrar
actor "Course Administrator" as CourseAdmin
actor Student
actor Librarian
actor "System Administrator" as SysAdmin

rectangle "Student Management System" {
  usecase "Student Management" as G1
  usecase "Enrollment\nManagement" as G4
  usecase "Student\nSelf-Service" as G6
  usecase "Identity & Access" as G5
  usecase "Course Management" as G3
  usecase "Book Management" as G2
}

Registrar --> G1
Registrar --> G4
Registrar --> G5
Registrar ..> G3 : reads\n(to enroll)

CourseAdmin --> G3
CourseAdmin --> G4
CourseAdmin --> G5
CourseAdmin ..> G1 : reads one\n(via roster)

Student --> G6
Student --> G5

Librarian --> G2
Librarian --> G5
Librarian ..> G1 : reads one\n(who holds it)

SysAdmin --> G5
@enduml
