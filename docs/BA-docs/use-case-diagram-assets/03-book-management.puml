@startuml
left to right direction
skinparam backgroundColor transparent
skinparam usecase {
  BackgroundColor #F6F8FA
  BorderColor #57606A
}
skinparam actor {
  BackgroundColor #EEF2FF
  BorderColor #3730A3
}

actor Librarian
actor Student

rectangle "Book Management" {
  usecase "UC-4\nAdd Book" as UC4
  usecase "UC-5\nAssign Book to Student" as UC5
  usecase "UC-6\nUnassign Book" as UC6
  usecase "UC-7\nRemove Book" as UC7
  usecase "UC-14\nView/Search Books" as UC14
  usecase "UC-18\nView Book Detail" as UC18
}

usecase "UC-16\nView Own Books, Courses\n& Enrollments\n(see Student Self-Service)" as UC16ext #line.dashed

Librarian --> UC4
Librarian --> UC5
Librarian --> UC6
Librarian --> UC7
Librarian --> UC14
Librarian --> UC18
Student --> UC18

UC18 ..> UC14 : <<extend>>
UC18 ..> UC16ext : <<extend>>
@enduml
