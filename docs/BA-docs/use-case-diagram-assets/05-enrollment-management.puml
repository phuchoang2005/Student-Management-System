@startuml
left to right direction
skinparam backgroundColor transparent
skinparam usecase {
  BackgroundColor #F6F8FA
  BorderColor #57606A
}
skinparam actor {
  BackgroundColor #EEF2FF
  BorderColor #3730A3
}

actor Registrar
actor "Course Administrator" as CourseAdmin

rectangle "Enrollment Management" {
  usecase "UC-11\nEnroll Student in Course" as UC11
  usecase "UC-26\nEnroll Student in\nMultiple Courses" as UC26
  usecase "UC-12\nEnd Enrollment" as UC12
  usecase "UC-20\nLook Up Enrollments" as UC20
}

Registrar --> UC26
Registrar --> UC11
Registrar --> UC12
Registrar --> UC20
CourseAdmin --> UC20

UC26 ..> UC11 : repeats per course,\nreporting each outcome

note bottom of UC20
  Reads only. Filtered by a
  student code or a course code,
  never both and never neither.
  A Student is not an actor here
  -- see UC-16.
end note
@enduml
