@startuml
left to right direction
skinparam backgroundColor transparent
skinparam nodesep 35
skinparam ranksep 90
skinparam usecase {
  BackgroundColor #F6F8FA
  BorderColor #57606A
}
skinparam actor {
  BackgroundColor #EEF2FF
  BorderColor #3730A3
}

actor "System Administrator" as SysAdmin
actor Registrar
actor Librarian
actor "Course Administrator" as CourseAdmin
actor Student

rectangle "Identity & Access" {
  usecase "UC-23\nView Student's\nInitial Password" as UC23
  usecase "UC-22\nChange Password" as UC22
  usecase "UC-21\nLogin" as UC21
  usecase "UC-24\nCreate Staff\nAccount" as UC24
  usecase "UC-25\nDeactivate/Reactivate\nStaff Account" as UC25
}

Registrar --> UC21
Registrar --> UC22
Registrar --> UC23
Librarian --> UC21
Librarian --> UC22
CourseAdmin --> UC21
CourseAdmin --> UC22
Student --> UC21
Student --> UC22
SysAdmin --> UC21
SysAdmin --> UC22
SysAdmin --> UC24
SysAdmin --> UC25

UC22 ..> UC21 : requires active session
UC25 ..> UC24 : targets an account\ncreated via UC-24
@enduml
