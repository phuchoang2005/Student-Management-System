%% Package Map — org.phuchoang2005.management
%% Maps the domain model in classes/class-diagram.mmd onto Spring Boot layers.
%% ---
%% Dependency rule: arrows point INWARD only.
%%   api -> application -> domain
%%   infrastructure -> domain   (implements domain repository interfaces)
%% The domain package never imports api, application, or infrastructure.

flowchart TB

  subgraph API["api  —  HTTP boundary"]
    direction TB
    subgraph API_C["controller"]
      CtrlS["StudentController<br/>BookController<br/>CourseController"]
      CtrlR["StudentBookController<br/>StudentCourseController"]
    end
    subgraph API_D["dto"]
      DtoIn["student/ StudentCreateRequest, StudentUpdateRequest<br/>book/ BookCreateRequest, BookUpdateRequest<br/>course/ CourseCreateRequest, CourseUpdateRequest"]
      DtoOut["StudentResponse, StudentSummaryResponse<br/>BookResponse, CourseResponse<br/>EnrollmentResponse, PageMetadata"]
    end
    subgraph API_E["error"]
      Adv["GlobalExceptionHandler @RestControllerAdvice<br/>ErrorResponse, ValidationErrorResponse"]
    end
    subgraph API_M["mapper"]
      Map["StudentMapper, BookMapper, CourseMapper<br/>(domain aggregate to/from DTO)"]
    end
  end

  subgraph APP["application  —  use-case orchestration, @Transactional"]
    direction TB
    AppS["StudentApplicationService<br/>BookApplicationService<br/>CourseApplicationService"]
    AppR["BookOwnershipApplicationService<br/>EnrollmentApplicationService"]
  end

  subgraph DOM["domain  —  no Spring, no JPA"]
    direction TB
    subgraph DOM_A["academic"]
      DomA["Student, Course, Enrollment «AggregateRoot»<br/>StudentId, CourseId, StudentCode, CourseCode, Email «ValueObject»<br/>EnrollmentPolicy «DomainService»<br/>StudentRepository, CourseRepository, EnrollmentRepository (interfaces)"]
    end
    subgraph DOM_L["library"]
      DomL["Book «AggregateRoot»<br/>BookId, ISBN «ValueObject»<br/>OwnershipPolicy «DomainService»<br/>BookRepository (interface)"]
    end
    subgraph DOM_E["exception"]
      DomE["DomainException<br/>ResourceNotFoundException<br/>DuplicateResourceException<br/>InvalidRelationshipException"]
    end
  end

  subgraph INF["infrastructure  —  adapters"]
    direction TB
    subgraph INF_P["persistence"]
      Jpa["StudentJpaRepository, CourseJpaRepository<br/>BookJpaRepository, EnrollmentJpaRepository<br/>(Spring Data interfaces + @Entity mappings)"]
    end
    subgraph INF_C["config"]
      Cfg["JpaAuditingConfig, OpenApiConfig<br/>WebMvcConfig"]
    end
  end

  DB[("PostgreSQL<br/>students, books, courses, student_courses")]

  %% Inward dependencies only
  CtrlS --> AppS
  CtrlR --> AppR
  CtrlS --> Map
  CtrlR --> Map
  Map --> DomA
  Map --> DomL
  Adv --> DomE

  AppS --> DomA
  AppS --> DomL
  AppR --> DomA
  AppR --> DomL

  Jpa -.->|implements| DomA
  Jpa -.->|implements| DomL
  Jpa --> DB

  classDef api fill:#fde,stroke:#333;
  classDef app fill:#ffe,stroke:#333;
  classDef dom fill:#eef,stroke:#333,stroke-width:2px;
  classDef inf fill:#efe,stroke:#333;
  classDef db fill:#ddd,stroke:#333;

  class CtrlS,CtrlR,DtoIn,DtoOut,Adv,Map api
  class AppS,AppR app
  class DomA,DomL,DomE dom
  class Jpa,Cfg inf
  class DB db

%% =============================================================================
%% Layer responsibilities
%% =============================================================================
%% api
%%   Binds HTTP to use cases. Owns DTOs, @Valid bean validation, pagination
%%   parameter binding (page/size/sort/search), Location headers, and the
%%   exception-to-status mapping. Contains NO business rule.
%% ---
%% application
%%   One method per use case. OWNS THE @Transactional BOUNDARY. Loads
%%   aggregates, invokes policies, calls aggregate behaviour, saves. This is
%%   the only layer allowed to touch more than one aggregate in one call — see
%%   sequences/delete-student.mmd.
%% ---
%% domain
%%   Aggregates, value objects, policies, repository INTERFACES, domain
%%   exceptions. Plain Java. No @Entity, no @Service, no @Transactional.
%% ---
%% infrastructure
%%   Spring Data JPA implementations of the domain repository interfaces,
%%   @Entity mappings, auditing, OpenAPI and MVC configuration.
%% ---
%% =============================================================================
%% Reconciling this with req.md §1
%% =============================================================================
%% req.md sketches a flat structure: config / controller / dto / entity /
%% repository / service / exception. That is the same set of concerns, just
%% grouped by TECHNICAL TYPE rather than by LAYER. The mapping is:
%% ---
%%   req.md            ->  here
%%   controller        ->  api.controller
%%   dto               ->  api.dto
%%   exception         ->  api.error (handler + envelopes)
%%                         + domain.exception (the thrown types)
%%   service           ->  application (orchestration)
%%                         + domain (policies — the rules themselves)
%%   entity            ->  domain (aggregates)
%%                         + infrastructure.persistence (@Entity mappings)
%%   repository        ->  domain (interfaces)
%%                         + infrastructure.persistence (Spring Data impls)
%%   config            ->  infrastructure.config
%% ---
%% Two deliberate departures from req.md:
%%   1. Business rules live in domain policies and aggregate methods, not in
%%      @Service classes. @Service only orchestrates.
%%   2. "entity" is split. The domain aggregate and the JPA @Entity are the
%%      same class ONLY IF the pragmatic option is taken (see below).
%% ---
%% =============================================================================
%% Pragmatic simplification actually chosen
%% =============================================================================
%% Strict hexagonal would keep domain aggregates and JPA entities as separate
%% classes with a mapper between them. For a system this size that doubles the
%% class count for no benefit, so:
%% ---
%%   The domain aggregate IS the JPA entity — annotated with @Entity and
%%   @Embeddable value objects — and lives in domain.*.
%% ---
%% The cost: domain depends on jakarta.persistence. That is an accepted,
%% documented trade-off, not an oversight. The rules that still hold and that
%% reviewers should enforce:
%%   - No Spring stereotype (@Service, @Component) in domain.
%%   - No @Transactional in domain.
%%   - No DTO import in domain.
%%   - Aggregates reference each other by identity (StudentId), never by
%%     @ManyToOne to another aggregate root.
%% ---
%% If the project later needs true persistence-ignorance, introduce
%% infrastructure.persistence.*Entity classes plus mappers. Nothing above the
%% domain layer changes when that happens.
