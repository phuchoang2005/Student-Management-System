%% Sequence: Delete Course
%% Contract: DELETE /courses/{courseId}  (operationId deleteCourse)
%% Success 204 | 404 course missing
%% Enrollments for the course are removed. Students survive. (req.md §16)

sequenceDiagram
  autonumber
  actor Admin as Academic Admin
  participant C as CourseController
  participant S as CourseApplicationService
  participant CR as CourseRepository
  participant ER as EnrollmentRepository

  Admin->>C: DELETE /courses/{courseId}
  C->>S: deleteCourse(CourseId)

  activate S
  Note over S: @Transactional boundary opens here

  S->>CR: existsById(courseId)
  CR-->>S: false
  alt course not found
    S-->>C: throw ResourceNotFoundException
    C-->>Admin: 404 ErrorResponse (code COURSE_NOT_FOUND)
  else course exists
    rect rgb(235, 235, 250)
      Note over S,ER: Step 1 — drop the course's enrollments
      S->>ER: deleteByCourseId(courseId)
      ER-->>S: n rows removed
    end

    rect rgb(250, 240, 235)
      Note over S,CR: Step 2 — remove the aggregate itself
      S->>CR: deleteById(courseId)
      CR-->>S: removed
    end

    Note over S: @Transactional boundary commits here
    S-->>C: void
    C-->>Admin: 204 No Content
  end
  deactivate S

  Note over S,ER: Students enrolled in the course are NOT deleted — only their<br/>student_courses rows for this course. Mirrors delete-student.mmd:<br/>the join rows always die with either parent, the parents never cascade<br/>into each other.
