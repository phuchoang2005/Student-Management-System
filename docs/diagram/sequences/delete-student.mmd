%% Sequence: Delete Student (cross-module orchestration)
%% Contract: DELETE /students/{studentId}  (operationId deleteStudent)
%% Success 204 | 404 student missing
%% Books survive as unowned. Courses survive. Only enrollments are destroyed.

sequenceDiagram
  autonumber
  actor Admin as Academic Admin
  participant C as StudentController
  participant S as StudentApplicationService
  participant SR as StudentRepository
  participant BR as BookRepository
  participant ER as EnrollmentRepository
  participant B as Book «AggregateRoot»

  Admin->>C: DELETE /students/{studentId}
  C->>S: deleteStudent(StudentId)

  activate S
  Note over S: @Transactional boundary opens here.<br/>All three cleanup steps commit or roll back together.

  S->>SR: findById(studentId)
  SR-->>S: Optional.empty()
  alt student not found
    S-->>C: throw ResourceNotFoundException
    C-->>Admin: 404 ErrorResponse (code STUDENT_NOT_FOUND)
  else student exists
    rect rgb(235, 245, 235)
      Note over S,B: Step 1 — library module: release ownership
      S->>BR: findByOwnerId(studentId)
      BR-->>S: List~Book~
      loop for each owned book
        S->>B: release()
        B-->>S: ownerId := null
      end
      S->>BR: saveAll(books)
      BR-->>S: persisted (student_id = NULL)
    end

    rect rgb(235, 235, 250)
      Note over S,ER: Step 2 — academic module: drop enrollments
      S->>ER: deleteByStudentId(studentId)
      ER-->>S: n rows removed
    end

    rect rgb(250, 240, 235)
      Note over S,SR: Step 3 — remove the aggregate itself
      S->>SR: deleteById(studentId)
      SR-->>S: removed
    end

    Note over S: @Transactional boundary commits here
    S-->>C: void
    C-->>Admin: 204 No Content
  end
  deactivate S

  Note over S: Ordering matters. Books are released BEFORE the student row is<br/>deleted so the books.student_id FK is never left dangling. This is the<br/>single orchestration point for cross-module cleanup — no domain events.
