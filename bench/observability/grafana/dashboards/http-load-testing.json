        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-benchmark"
          },
          "expr": "sum(rate(k6_http_reqs_total{status=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-benchmark"
          },
          "expr": "sum(rate(k6_http_reqs_total{status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "refId": "C",
          "range": true
