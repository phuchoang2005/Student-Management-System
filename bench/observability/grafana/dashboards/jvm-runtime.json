        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-benchmark"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-benchmark"
          },
          "expr": "process_cpu_usage{job=\"spring-boot-app\"}",
