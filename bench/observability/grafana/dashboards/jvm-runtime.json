    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory Allocation Rate",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-benchmark"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-benchmark"
          },
          "expr": "sum(rate(jvm_gc_memory_allocated_bytes_total{job=\"spring-boot-app\"}[$__rate_interval]))",
