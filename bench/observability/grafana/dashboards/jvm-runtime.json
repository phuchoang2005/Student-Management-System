{
  "uid": "bm-jvm-runtime",
  "title": "JVM Runtime",
  "tags": [
    "benchmark",
    "jvm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 2,
      "type": "timeseries",
      "title": "Heap Memory",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-benchmark"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-benchmark"
          },
          "expr": "sum(jvm_memory_used_bytes{job=\"spring-boot-app\", area=\"heap\"})",
          "legendFormat": "used",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-benchmark"
          },
          "expr": "sum(jvm_memory_committed_bytes{job=\"spring-boot-app\", area=\"heap\"})",
          "legendFormat": "committed",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-benchmark"
          },
          "expr": "sum(jvm_memory_max_bytes{job=\"spring-boot-app\", area=\"heap\"})",
          "legendFormat": "max",
          "refId": "C",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "pointSize": 5,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Non-Heap Memory (Metaspace / Code Cache / Compressed Class Space)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-benchmark"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-benchmark"
          },
          "expr": "jvm_memory_used_bytes{job=\"spring-boot-app\", area=\"nonheap\", id=\"Metaspace\"}",
          "legendFormat": "Metaspace",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-benchmark"
          },
          "expr": "jvm_memory_used_bytes{job=\"spring-boot-app\", area=\"nonheap\", id=\"CodeCache\"}",
          "legendFormat": "Code Cache",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-benchmark"
          },
          "expr": "jvm_memory_used_bytes{job=\"spring-boot-app\", area=\"nonheap\", id=\"Compressed Class Space\"}",
          "legendFormat": "Compressed Class Space",
          "refId": "C",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "pointSize": 5,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GC Pause Duration (rate)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-benchmark"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-benchmark"
          },
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{job=\"spring-boot-app\"}[$__rate_interval])) by (action)",
          "legendFormat": "{{action}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "pointSize": 5,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GC Pause Frequency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-benchmark"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-benchmark"
          },
          "expr": "sum(rate(jvm_gc_pause_seconds_count{job=\"spring-boot-app\"}[$__rate_interval])) by (action)",
          "legendFormat": "{{action}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "pointSize": 5,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
